use clap::Parser;
use rayon::prelude::*;
use sha1::{Digest, Sha1};
use std::collections::HashMap;
use std::fs::File;
use std::io::{self, BufReader, Read, Write};
use std::path::{Path, PathBuf};
use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
use std::sync::{Arc, Mutex};
use std::thread;
use std::time::Duration;
use walkdir::WalkDir;

#[derive(Parser, Debug)]
#[command(author, version, about, long_about = None)]
struct Args {
    /// The path to the target directory
    #[arg(short, long, value_name = "DIR")]
    directory: PathBuf,

    /// Number of threads to use
    #[arg(short, long, value_name = "INT", default_value = "2")]
    threads: usize,
}

fn main() -> io::Result<()> {

    let args = Args::parse();

	// Allowed media extensions (lowercase)
    let media_extensions: std::collections::HashSet<&str> = [
        "jpg", "jpeg", "png", "gif", "bmp", "tiff", "webp", // Images
        "mp4", "mkv", "avi", "mov", "flv", "wmv", "webm",   // Videos
        "mp3", "wav", "flac", "ogg", "m4a", "aac",          // Audio
    ].iter().cloned().collect();


    if args.directory.is_dir() {
        println!("Successfully passed directory: {:?}", args.directory);
    } else {
        println!("Error: Path is not a directory or does not exist: {:?}", args.directory);
        std::process::exit(1);
    }

    // Set thread limits explicitly based on clap defaults or user inputs
    rayon::ThreadPoolBuilder::new()
        .num_threads(args.threads)
        .build_global()
        .unwrap();
    println!("Thread pool initialized with {} threads.", args.threads);

    let target_dir = &args.directory;

    let dir_name = target_dir
        .file_name()
        .map(|n| n.to_string_lossy().into_owned())
        .unwrap_or_else(|| "root".to_string());

    println!("Scanning directory and indexing files...");
    
    // Collect only matching media files in a single thread
    let files: Vec<PathBuf> = WalkDir::new(target_dir)
        .into_iter()
        .filter_map(|e| e.ok())
        .filter(|e| {
            if e.path().is_file() {
                if let Some(ext) = e.path().extension().and_then(|s| s.to_str()) {
                    return media_extensions.contains(ext.to_lowercase().as_str());
                }
            }
            false
        })
        .map(|e| e.path().to_path_buf())
        .collect();

    println!("Starting parallel hashing on {} files...", files.len());

    // Thread-safe accumulators for parallel context
    let sha_map_mutex = Mutex::new(HashMap::<String, Vec<PathBuf>>::new());
    let file_count = Arc::new(AtomicUsize::new(0));
    let is_running = Arc::new(AtomicBool::new(true));

    // Spawn the background UI thread to isolate the spinner timing
    let ui_file_count = Arc::clone(&file_count);
    let ui_is_running = Arc::clone(&is_running);
    let ui_handle = thread::spawn(move || {
        let spinner_frames = ['-', '\\', '|', '/'];
        let mut frame_idx = 0;

        while ui_is_running.load(Ordering::Relaxed) {
            let current_count = ui_file_count.load(Ordering::Relaxed);
            let spinner_char = spinner_frames[frame_idx % spinner_frames.len()];
            
            print!("\rFiles processed: {} {}", current_count, spinner_char);
            let _ = io::stdout().flush();
            
            frame_idx += 1;
            // Sleep for 500ms to guarantee a smooth, reliable 10Hz animation cadence
            thread::sleep(Duration::from_millis(250));
        }
    });

    // Parallel processing pipeline powered by Rayon
    files.par_iter().for_each(|path| {
        if let Ok(sha1_hex) = compute_sha1(path) {
            // Securely push the result into our protected SHA map
            let mut map = sha_map_mutex.lock().unwrap();
            map.entry(sha1_hex).or_default().push(path.clone());

            // Increment atomic counter safely across threads
            file_count.fetch_add(1, Ordering::Relaxed);
        }
    });

    // Stop the UI thread and join it back safely before cleaning up the prompt line
    is_running.store(false, Ordering::Relaxed);
    let _ = ui_handle.join();

    // Clear the ticker line completely and print the exact total
    print!("\r                                           ");
    let sha_map = sha_map_mutex.into_inner().unwrap();
    let total_processed = file_count.load(Ordering::Relaxed);
    println!("\rScan complete! Total files processed: {}", total_processed);

    let tree_filename = get_unique_filename(&dir_name, "tree_output", "txt");
    let tsv_filename = get_unique_filename(&dir_name, "output", "csv");
    let dupes_filename = get_unique_filename(&dir_name, "DupesQ", "txt");

    println!("Generating report files...");

    // 2. Generate Output 1: Plain text file with simple tree structure
    generate_tree_output(target_dir, &sha_map, &tree_filename)?;

    // 3. Generate Output 2: Tab-separated CSV file
    generate_tsv_output(&sha_map, &tsv_filename)?;

    // 4. Generate Output 3: DupesQ file containing matching duplicate groups
    generate_dupes_output(&sha_map, &dupes_filename)?;

    println!("\nAll operations completed successfully:");
    println!(" -> Tree layout: {}", tree_filename.display());
    println!(" -> TSV Registry: {}", tsv_filename.display());
    println!(" -> Duplicates:  {}", dupes_filename.display());

    Ok(())
}

/// Helper function to find a unique, unallocated sequential filename
fn get_unique_filename(dir_name: &str, base_suffix: &str, extension: &str) -> PathBuf {
    let mut index = 1;
    loop {
        let filename = format!("{}_{}_{}.{}", dir_name, base_suffix, index, extension);
        let path = PathBuf::from(filename);
        if !path.exists() {
            return path;
        }
        index += 1;
    }
}

/// Helper function to compute the SHA-1 checksum hex string using sha1 v0.11
fn compute_sha1(path: &Path) -> io::Result<String> {
    let file = File::open(path)?;
    let mut reader = BufReader::new(file);
    let mut hasher = Sha1::new();
    let mut buffer = [0u8; 8192];

    loop {
        let count = reader.read(&mut buffer)?;
        if count == 0 {
            break;
        }
        hasher.update(&buffer[..count]);
    }

    let digest = hasher.finalize();
    let hex_string = digest.iter().map(|b| format!("{:02x}", b)).collect();

    Ok(hex_string)
}

/// Builds a structured plain text tree where lines use the format: filename : sha1
fn generate_tree_output(root: &Path, sha_map: &HashMap<String, Vec<PathBuf>>, output_path: &Path) -> io::Result<()> {
    let mut path_to_sha: HashMap<&Path, &str> = HashMap::new();
    for (sha, paths) in sha_map {
        for path in paths {
            path_to_sha.insert(path.as_path(), sha);
        }
    }

    let mut output = File::create(output_path)?;

    // Walk over the directory tree again to cleanly preserve alphabetical order hierarchy
    let mut entries: Vec<_> = WalkDir::new(root)
        .into_iter()
        .filter_map(|e| e.ok())
        .collect();

    // Sort entries strictly alphabetically by path to handle variations cleanly
    entries.sort_by(|a, b| a.path().cmp(b.path()));

    for entry in entries {
        let path = entry.path();
        let depth = entry.depth();
        let indent = " ".repeat(depth * 2);
        let name = path.file_name().map(|n| n.to_string_lossy()).unwrap_or_default();

        if path.is_dir() {
            writeln!(output, "{}{}/", indent, name)?;
        } else if let Some(sha1) = path_to_sha.get(path) {
            writeln!(output, "{}{} : {}", indent, name, sha1)?;
        }
    }
    Ok(())
}

/// Generates a clean, tab-separated table matching paths to hashes sorted by file paths
fn generate_tsv_output(sha_map: &HashMap<String, Vec<PathBuf>>, output_path: &Path) -> io::Result<()> {
    let mut output = File::create(output_path)?;

    writeln!(output, "File Path\tSHA1")?;

    // Collect all paths along with their associated SHA-1
    let mut sorted_entries: Vec<(&PathBuf, &String)> = Vec::new();
    for (sha, paths) in sha_map {
        for path in paths {
            sorted_entries.push((path, sha));
        }
    }

    // Sort the list alphabetically by the file path
    sorted_entries.sort_by(|a, b| a.0.cmp(b.0));

    for (path, sha) in sorted_entries {
        writeln!(output, "{}\t{}", path.display(), sha)?;
    }
    Ok(())
}

/// Filters and logs duplicate files into clusters within the resolved DupesQ file
fn generate_dupes_output(sha_map: &HashMap<String, Vec<PathBuf>>, output_path: &Path) -> io::Result<()> {
    let mut output = File::create(output_path)?;

    // Filter and collect groups that have duplicates
    let mut duplicate_groups: Vec<(String, Vec<PathBuf>)> = sha_map
        .iter()
        .filter(|(_, paths)| paths.len() > 1)
        .map(|(sha, paths)| {
            let mut sorted_paths = paths.clone();
            sorted_paths.sort(); // Sort internal file paths within each duplicate group
            (sha.clone(), sorted_paths)
        })
        .collect();

    // Sort the groups themselves alphabetically based on the first file path in the group
    duplicate_groups.sort_by(|a, b| a.1.cmp(&b.1));

    let mut index = 1;
    for (sha, paths) in duplicate_groups {
        writeln!(output, "Duplicate Group #{}: [SHA-1: {}]", index, sha)?;
        for path in paths {
            writeln!(output, " -> {}", path.display())?;
        }
        writeln!(output, "")?;
        index += 1;
    }

    if index == 1 {
        writeln!(output, "No duplicate files found.")?;
    }
    Ok(())
}

